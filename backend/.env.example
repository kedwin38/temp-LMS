DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
DATA_UPLOAD_MAX_MEMORY_SIZE=2147483648
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# Optional: durable S3-compatible object storage for uploaded course materials
# (videos/PDFs). Leave AWS_STORAGE_BUCKET_NAME unset to use local disk, which
# is fine for development but is wiped on redeploy on hosts like Render.
# Works with AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO...
# AWS_STORAGE_BUCKET_NAME=my-shire-jama-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=auto
# Only needed for non-AWS S3-compatible providers, e.g. Cloudflare R2:
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Optional public CDN/custom domain instead of signed URLs:
# AWS_S3_CUSTOM_DOMAIN=
# AWS_QUERYSTRING_AUTH=True
# AWS_QUERYSTRING_EXPIRE=3600